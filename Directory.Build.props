<Project>
  <!--
    Versão única do LogBeam Uplink: vale para todos os projectos e chega ao título da janela
    (AppVersion), aos dados da instalação, ao instalador (lida do LogBeam.exe) e à etiqueta da
    release (o release.yml recusa uma etiqueta vX.Y.Z diferente).
  -->
  <PropertyGroup>
    <Version>2.5.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
