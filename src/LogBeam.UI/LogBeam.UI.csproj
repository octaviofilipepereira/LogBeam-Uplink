<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LogBeam</AssemblyName>
    <RootNamespace>LogBeam.UI</RootNamespace>
    <AssemblyTitle>LogBeam</AssemblyTitle>
    <Company>CT7BFV</Company>
    <Product>LogBeam</Product>
    <Description>N1MM+ to Amateur Radio Logbooks Bridge</Description>
    <Copyright>© 2026 Octávio Filipe Pereira Gonçalves</Copyright>
    <Version>2.1.0</Version>
    <ApplicationIcon>Resources\logbeam.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LogBeam.Core\LogBeam.Core.csproj" />
    <ProjectReference Include="..\LogBeam.Service\LogBeam.Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Serilog" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Polly" Version="8.4.1" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*" Exclude="Resources\*.ico" />
    <None Include="Resources\logbeam.ico" />
  </ItemGroup>

</Project>
